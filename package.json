{
  "name": "@mibo-ai/n8n-nodes-mibo-testing",
  "version": "2.0.0",
  "description": "Capture n8n workflow traces and send them to Mibo Testing for AI testing and assertions.",
  "license": "MIT",
  "homepage": "https://github.com/mibo-ai/mibo-testing-n8n-node",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "workflow",
    "testing",
    "trace",
    "mibo"
  ],
  "author": {
    "name": "Mibo Testing",
    "email": "support@mibo-ai.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mibo-ai/mibo-testing-n8n-node.git"
  },
  "bugs": {
    "url": "https://github.com/mibo-ai/mibo-testing-n8n-node/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "watch": "tsc --watch",
    "check": "oxfmt --check nodes credentials && eslint package.json nodes credentials",
    "check:fix": "oxfmt --write nodes credentials && eslint package.json nodes credentials --fix",
    "lint": "pnpm run check",
    "lint:fix": "pnpm run check:fix",
    "lint:n8n": "eslint package.json nodes credentials",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "node scripts/dev-docker.mjs",
    "dev:local:install": "node scripts/install-local-n8n.mjs",
    "dev:local": "node scripts/dev.mjs",
    "dev:link": "pnpm run build && pnpm link",
    "skills:sync": "skills add ./skills -y",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MiboTestingApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MiboTesting/MiboTesting.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.39.3",
    "@types/node": "^22.0.0",
    "chokidar": "^4.0.0",
    "eslint": "9.29.0",
    "oxfmt": "0.63.0",
    "n8n-workflow": "^2.7.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "skills": "^1.5.7",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
