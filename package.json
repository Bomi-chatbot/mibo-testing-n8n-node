{
  "name": "@mibo-ai/n8n-nodes-mibo-testing",
  "version": "0.2.1",
  "description": "n8n community node for Mibo Testing - Capture and send workflow traces for semantic and procedural testing",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mibo-ai/mibo-testing-n8n-node",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "workflow",
    "testing",
    "trace",
    "mibo"
  ],
  "author": {
    "name": "Mibo Testing",
    "email": "support@mibo-ai.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mibo-ai/mibo-testing-n8n-node.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "build": "tsc && pnpm run copy:icons",
    "copy:icons": "node scripts/copy-icons.mjs",
    "watch": "tsc --watch",
    "check": "biome check nodes credentials",
    "check:fix": "biome check --fix nodes credentials",
    "skills:sync": "skills add ./skills -y",
    "prepublishOnly": "pnpm run build",
    "------- DEV -------": "echo 'Development commands'",
    "dev": "node scripts/dev.mjs",
    "dev:docker": "node scripts/dev-docker.mjs",
    "dev:link": "pnpm run build && pnpm link",
    "------- PROD -------": "echo 'Production commands'",
    "docker:build": "docker build -t n8n-mibo-testing:latest .",
    "docker:run": "docker compose up -d",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MiboTestingApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MiboTesting/MiboTesting.node.js"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^22.0.0",
    "chokidar": "^4.0.0",
    "n8n-workflow": "*",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "skills": "^1.5.7",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
